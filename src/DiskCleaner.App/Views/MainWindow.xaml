<Window x:Class="DiskCleaner.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiskCleaner.App.ViewModels"
        Title="DiskCleaner — безопасная очистка дисков Windows" Height="760" Width="1180"
        MinHeight="560" MinWidth="900">
    <Window.Resources>
        <Style x:Key="RiskTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="4,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RiskDisplay}" Value="Safe">
                    <Setter Property="Foreground" Value="{StaticResource SafeBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RiskDisplay}" Value="Review">
                    <Setter Property="Foreground" Value="{StaticResource ReviewBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RiskDisplay}" Value="Manual">
                    <Setter Property="Foreground" Value="{StaticResource ManualBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок + верхние действия -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Диски" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Анализ диска" Padding="12,6" Margin="0,0,8,0" Command="{Binding OpenDiskAnalysisCommand}"/>
                <Button Content="Firefox" Padding="12,6" Margin="0,0,8,0" Command="{Binding OpenFirefoxCommand}"/>
                <Button Content="Логи" Padding="12,6" Margin="0,0,8,0" Command="{Binding OpenLogsCommand}"/>
                <Button Content="Настройки" Padding="12,6" Margin="0,0,8,0" Command="{Binding OpenSettingsCommand}"/>
                <Button Content="Scan" Padding="20,6" FontWeight="Bold" Command="{Binding ScanCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Список дисков -->
        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1">
            <ListView ItemsSource="{Binding Drives}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="30">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Диск" Width="60" DisplayMemberBinding="{Binding Letter}"/>
                        <GridViewColumn Header="Метка" Width="120" DisplayMemberBinding="{Binding VolumeLabel}"/>
                        <GridViewColumn Header="Всего" Width="90" DisplayMemberBinding="{Binding TotalDisplay}"/>
                        <GridViewColumn Header="Занято" Width="90" DisplayMemberBinding="{Binding UsedDisplay}"/>
                        <GridViewColumn Header="Свободно" Width="90" DisplayMemberBinding="{Binding FreeDisplay}"/>
                        <GridViewColumn Header="ФС" Width="70" DisplayMemberBinding="{Binding FileSystem}"/>
                        <GridViewColumn Header="Тип" Width="90" DisplayMemberBinding="{Binding DriveTypeDisplay}"/>
                        <GridViewColumn Header="Системный" Width="90" DisplayMemberBinding="{Binding IsSystemDrive}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Статус -->
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="DarkSlateGray" Margin="0,8,0,4"/>

        <!-- Фильтры экрана результатов -->
        <DockPanel Grid.Row="3" Margin="0,0,0,6">
            <TextBlock Text="Результаты сканирования" FontSize="16" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="Диск:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Width="110" Margin="0,0,16,0" ItemsSource="{Binding FilterDriveOptions}" SelectedItem="{Binding FilterDrive}"/>
                <TextBlock Text="Риск:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Width="110" ItemsSource="{Binding FilterRiskOptions}" SelectedItem="{Binding FilterRisk}"/>
            </StackPanel>
        </DockPanel>

        <!-- Таблица найденных целей -->
        <Border Grid.Row="4" BorderBrush="LightGray" BorderThickness="1">
            <ListView ItemsSource="{Binding TargetsView}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="30">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Риск" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RiskDisplay}" Style="{StaticResource RiskTextStyle}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Категория" Width="150" DisplayMemberBinding="{Binding CategoryDisplay}"/>
                        <GridViewColumn Header="Приложение" Width="110" DisplayMemberBinding="{Binding AppName}"/>
                        <GridViewColumn Header="Диск" Width="45" DisplayMemberBinding="{Binding DriveLetter}"/>
                        <GridViewColumn Header="Путь" Width="260" DisplayMemberBinding="{Binding FullPath}"/>
                        <GridViewColumn Header="Размер" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeDisplay}" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Изменён" Width="120" DisplayMemberBinding="{Binding LastModifiedDisplay}"/>
                        <GridViewColumn Header="Статус" Width="150" DisplayMemberBinding="{Binding StatusText}"/>
                        <GridViewColumn Header="" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Open folder" Padding="6,2" Command="{Binding OpenFolderCommand}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Панель действий -->
        <DockPanel Grid.Row="5" Margin="0,10,0,0">
            <CheckBox DockPanel.Dock="Left" Content="Тестовый прогон (dry run) — ничего не удалять"
                      IsChecked="{Binding IsDryRun}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock VerticalAlignment="Center" Margin="0,0,16,0">
                    <Run Text="Доступно к очистке: "/>
                    <Run Text="{Binding TotalReclaimableText, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="Bold">
                    <Run Text="Выбрано: "/>
                    <Run Text="{Binding TotalSelectedSizeText, Mode=OneWay}"/>
                </TextBlock>
                <Button Content="Cancel" Padding="16,6" Margin="0,0,10,0" Command="{Binding CancelCommand}"/>
                <Button Content="Clean selected" Padding="20,6" Command="{Binding CleanCommand}"
                        Background="#C0392B" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
            <Grid/>
        </DockPanel>
    </Grid>
</Window>
