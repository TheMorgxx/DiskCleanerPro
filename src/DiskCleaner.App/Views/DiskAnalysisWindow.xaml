<Window x:Class="DiskCleaner.App.Views.DiskAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Анализ диска — что занимает место" Height="760" Width="1200"
        MinHeight="520" MinWidth="900" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и запуск анализа -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Анализ диска" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="Диск:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Width="110" Margin="0,0,12,0" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot}"/>
                <Button Content="Анализ" Padding="20,6" FontWeight="Bold" Margin="0,0,8,0" Command="{Binding AnalyzeCommand}"/>
                <Button Content="Cancel" Padding="16,6" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Статусы -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Анализ только читает диск — ничего не удаляет. Удаление — отдельной кнопкой внизу, после подтверждения."
                       Foreground="Gray" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatusText}" Foreground="DarkSlateGray" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding HeaderText}" FontWeight="Bold" Margin="0,2,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="Программа запущена без прав администратора — часть системных папок не прочитана, отчёт неполный."
                       Foreground="DarkRed" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding ShowAdminWarning, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ProgressText}" Foreground="Gray" FontSize="11" Margin="0,2,0,2" TextTrimming="CharacterEllipsis"/>
            <ProgressBar Height="4" IsIndeterminate="{Binding IsBusy, Mode=OneWay}"/>
        </StackPanel>

        <!-- Результаты -->
        <TabControl Grid.Row="2">
            <TabItem Header="Известные места">
                <ListView ItemsSource="{Binding KnownPlaceRows}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="30">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Размер" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeDisplay}" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Изменён" Width="120" DisplayMemberBinding="{Binding LastModifiedDisplay}"/>
                            <GridViewColumn Header="Что это" Width="160" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="Путь" Width="380" DisplayMemberBinding="{Binding Path}"/>
                            <GridViewColumn Header="Статус" Width="300" DisplayMemberBinding="{Binding StatusText}"/>
                            <GridViewColumn Header="" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Показать" Padding="6,2" Command="{Binding ShowInExplorerCommand}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="Тяжёлые папки">
                <ListView ItemsSource="{Binding DirectoryRows}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="30">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Размер" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeDisplay}" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Изменён" Width="120" DisplayMemberBinding="{Binding LastModifiedDisplay}"/>
                            <GridViewColumn Header="Что это" Width="160" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="Путь" Width="380" DisplayMemberBinding="{Binding Path}"/>
                            <GridViewColumn Header="Статус" Width="300" DisplayMemberBinding="{Binding StatusText}"/>
                            <GridViewColumn Header="" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Показать" Padding="6,2" Command="{Binding ShowInExplorerCommand}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="Тяжёлые файлы">
                <ListView ItemsSource="{Binding FileRows}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="30">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Размер" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeDisplay}" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Изменён" Width="120" DisplayMemberBinding="{Binding LastModifiedDisplay}"/>
                            <GridViewColumn Header="Что это" Width="160" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="Путь" Width="380" DisplayMemberBinding="{Binding Path}"/>
                            <GridViewColumn Header="Статус" Width="300" DisplayMemberBinding="{Binding StatusText}"/>
                            <GridViewColumn Header="" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Показать" Padding="6,2" Command="{Binding ShowInExplorerCommand}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="Папки-пожиратели">
                <ListView ItemsSource="{Binding SuspectRows}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="30">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Размер" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeDisplay}" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Изменён" Width="120" DisplayMemberBinding="{Binding LastModifiedDisplay}"/>
                            <GridViewColumn Header="Что это" Width="160" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="Путь" Width="380" DisplayMemberBinding="{Binding Path}"/>
                            <GridViewColumn Header="Статус" Width="300" DisplayMemberBinding="{Binding StatusText}"/>
                            <GridViewColumn Header="" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Показать" Padding="6,2" Command="{Binding ShowInExplorerCommand}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="Расширения">
                <ListView ItemsSource="{Binding Extensions}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Расширение" Width="200" DisplayMemberBinding="{Binding Extension}"/>
                            <GridViewColumn Header="Суммарный размер" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeDisplay}" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
        </TabControl>

        <!-- Панель действий -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <CheckBox Content="Тестовый прогон (dry run) — ничего не удалять" IsChecked="{Binding IsDryRun}"/>
                <CheckBox Content="Отправлять в Корзину (место на диске освободится только после очистки Корзины)"
                          IsChecked="{Binding UseRecycleBin}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="{Binding SelectedSizeText}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="Скопировать отчёт" Padding="12,6" Margin="0,0,8,0" Command="{Binding CopyReportCommand}"/>
                <Button Content="Сохранить отчёт" Padding="12,6" Margin="0,0,8,0" Command="{Binding SaveReportCommand}"/>
                <Button Content="Снять выбор" Padding="12,6" Margin="0,0,10,0" Command="{Binding ClearSelectionCommand}"/>
                <Button Content="Удалить выбранное" Padding="20,6" Command="{Binding DeleteSelectedCommand}"
                        Background="#C0392B" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
            <Grid/>
        </DockPanel>
    </Grid>
</Window>
