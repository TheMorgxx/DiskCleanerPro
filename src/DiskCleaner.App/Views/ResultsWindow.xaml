<Window x:Class="DiskCleaner.App.Views.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Результаты очистки" Height="560" Width="760"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding HeaderText}" FontSize="16" FontWeight="Bold"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Margin="0,0,20,0">
                <Run Text="Файлов удалено: "/>
                <Run Text="{Binding TotalFilesDeleted, Mode=OneWay}" FontWeight="Bold"/>
            </TextBlock>
            <TextBlock Margin="0,0,20,0">
                <Run Text="Пропущено: "/>
                <Run Text="{Binding TotalFilesSkipped, Mode=OneWay}" FontWeight="Bold"/>
            </TextBlock>
            <TextBlock>
                <Run Text="Ошибок доступа: "/>
                <Run Text="{Binding Errors.Count, Mode=OneWay}" FontWeight="Bold"/>
            </TextBlock>
        </StackPanel>

        <TabControl Grid.Row="2">
            <TabItem Header="По категориям">
                <ListView ItemsSource="{Binding Entries}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Категория" Width="220" DisplayMemberBinding="{Binding TargetDisplayName}"/>
                            <GridViewColumn Header="До" Width="90" DisplayMemberBinding="{Binding SizeBeforeBytes}"/>
                            <GridViewColumn Header="После" Width="90" DisplayMemberBinding="{Binding SizeAfterBytes}"/>
                            <GridViewColumn Header="Освобождено" Width="110" DisplayMemberBinding="{Binding FreedBytes}"/>
                            <GridViewColumn Header="Удалено файлов" Width="110" DisplayMemberBinding="{Binding FilesDeleted}"/>
                            <GridViewColumn Header="Пропущено" Width="90" DisplayMemberBinding="{Binding FilesSkipped}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="Пропущенные элементы">
                <ListView ItemsSource="{Binding SkippedItems}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Причина" Width="140" DisplayMemberBinding="{Binding Reason}"/>
                            <GridViewColumn Header="Путь" Width="420" DisplayMemberBinding="{Binding Path}"/>
                            <GridViewColumn Header="Подробности" Width="150" DisplayMemberBinding="{Binding Detail}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="Ошибки">
                <ListBox ItemsSource="{Binding Errors}" FontFamily="Consolas" FontSize="11"/>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="DarkRed" FontWeight="Bold"
                   Visibility="{Binding DryRun, Converter={StaticResource BoolToVis}}"
                   Text="Это был тестовый прогон (dry run) — реально ничего не удалялось."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Закрыть" Padding="18,6" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
