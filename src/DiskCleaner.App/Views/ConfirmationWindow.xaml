<Window x:Class="DiskCleaner.App.Views.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтвердите удаление" Height="480" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Внимательно проверьте список перед удалением:"
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" Margin="10" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
            </ScrollViewer>
        </Border>

        <StackPanel x:Name="RequiredWordPanel" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="RequiredWordPrompt" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBox x:Name="RequiredWordTextBox" TextChanged="OnRequiredWordChanged"
                     MinWidth="200" HorizontalAlignment="Left" Padding="4"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Отмена" Padding="18,6" Margin="0,0,10,0" Click="OnCancelClick" IsCancel="True"/>
            <Button x:Name="ConfirmButton" Content="Удалить" Padding="18,6" Background="#C0392B" Foreground="White" FontWeight="Bold"
                    Click="OnConfirmClick" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
