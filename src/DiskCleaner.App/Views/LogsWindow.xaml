<Window x:Class="DiskCleaner.App.Views.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал операций" Height="480" Width="820" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderTextBlock" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1">
            <ListBox x:Name="LogListBox" FontFamily="Consolas" FontSize="11"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Открыть папку с логами" Padding="12,6" Margin="0,0,10,0" Click="OnOpenFolderClick"/>
            <Button Content="Закрыть" Padding="18,6" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
