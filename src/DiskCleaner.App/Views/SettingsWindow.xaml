<Window x:Class="DiskCleaner.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="420" Width="560" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Пути, исключённые из очистки" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" Text="(даже если путь подходит под безопасное правило — он не будет предложен к удалению)"
                   Foreground="Gray" Margin="0,22,0,10" TextWrapping="Wrap"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Добавить" Padding="12,4" Click="OnAddClick"/>
            <TextBox x:Name="NewPathTextBox" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1">
            <ListBox x:Name="ExcludedPathsListBox" ItemsSource="{Binding}"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Удалить выбранное" Padding="12,6" Margin="0,0,10,0" Click="OnRemoveClick"/>
            <Button Content="Закрыть" Padding="18,6" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
