<Window Style="{StaticResource DarkWindowStyle}" x:Class="DiskCleaner.App.Views.SkippedItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DiskCleaner.App.Localization"
        Title="Пропущенные элементы" Height="520" Width="900" MinHeight="300" MinWidth="560"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <loc:SkipReasonConverter x:Key="SkipReasonConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="16" FontWeight="Bold"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <ListView x:Name="ItemsList" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Причина" Width="190"
                                    DisplayMemberBinding="{Binding Reason, Converter={StaticResource SkipReasonConverter}}"/>
                    <GridViewColumn Header="Путь" Width="400">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Подробности" Width="260">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Закрыть" Padding="18,6" Click="OnCloseClick" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
