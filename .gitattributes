# Normalize line endings in the repository; keep Windows scripts CRLF in the working tree
# (batch files with labels break when they are checked out with LF only).
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.sh text eol=lf
*.png binary
*.ico binary
*.exe binary
*.dll binary
