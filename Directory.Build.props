<Project>
  <PropertyGroup>
    <!-- Default product version. The release script overrides it with the tag: -p:Version=1.2.3 -->
    <Version>1.0.0</Version>
    <Product>DiskCleanerPro</Product>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PathMap>$(MSBuildThisFileDirectory)=/_/src/</PathMap>
  </PropertyGroup>
</Project>
